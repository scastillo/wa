#!/bin/sh
# wa launcher for the plugin. Claude Code puts this bin/ folder on PATH. The
# launcher runs the first binary it finds:
#   1. $WA_BIN, when set.
#   2. dist/wa in the plugin folder: a local build in a developer checkout.
#   3. The release binary for the plugin version, cached in ~/.local/share/wa/bin.
#      The first run downloads it from the public release with curl and checks it
#      against the release SHA256SUMS. No GitHub account is needed. A link named
#      wa next to it lets the user run wa in their own terminal, for `wa allow`.
set -eu

repo=scastillo/wa

die() {
	printf 'wa: %s\n' "$*" >&2
	exit 1
}

if [ -n "${WA_BIN:-}" ]; then
	exec "$WA_BIN" "$@"
fi

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ -x "$root/dist/wa" ]; then
	exec "$root/dist/wa" "$@"
fi

[ "$(uname -s)" = Darwin ] || die "wa reads WhatsApp Desktop data on macOS only"
case $(uname -m) in
arm64) arch=arm64 ;;
x86_64) arch=amd64 ;;
*) die "there is no wa release for this CPU: $(uname -m)" ;;
esac

version=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" | head -n 1)
[ -n "$version" ] || die "cannot read the plugin version from $root/.claude-plugin/plugin.json"

asset=wa-darwin-$arch
url=https://github.com/$repo/releases/download/v$version
cache=$HOME/.local/share/wa/bin
bin=$cache/wa-$version-darwin-$arch

if [ ! -x "$bin" ]; then
	command -v curl >/dev/null 2>&1 || die "wa needs curl to download its binary"
	mkdir -p "$cache"
	part=$bin.part.$$
	if ! curl -fsSL --retry 2 -o "$part" "$url/$asset"; then
		rm -f "$part"
		die "cannot download $asset from $url. Check your network, or save that file yourself as $bin"
	fi
	sums=$(curl -fsSL --retry 2 "$url/SHA256SUMS") || sums=''
	want=$(printf '%s\n' "$sums" | awk -v f="$asset" '$2 == f { print $1; exit }')
	got=$(shasum -a 256 "$part" | awk '{ print $1 }')
	if [ -z "$want" ] || [ "$want" != "$got" ]; then
		rm -f "$part"
		die "the downloaded $asset does not match the release checksum. Nothing was installed"
	fi
	chmod 755 "$part"
	mv -f "$part" "$bin"
fi

ln -sfn "wa-$version-darwin-$arch" "$cache/wa"
exec "$bin" "$@"
